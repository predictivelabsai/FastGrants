# --- FastGrants ------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored — never commit secrets.

FASTGRANTS_ADMIN_EMAIL=admin@fastgrants.example
FASTGRANTS_ADMIN_PASSWORD=FastGrants2026$
FASTGRANTS_SECRET=
FASTGRANTS_PORT=5015
FASTGRANTS_ENV_LABEL=FastGrants
# Blank => ./fastgrants.sqlite. In Docker point at the mounted volume.
FASTGRANTS_DB=

# --- AI assistant ----------------------------------------------------------
# Free-form chat uses one provider; slash-commands (/budget, /pipeline …) need no key.
#   MODEL_PROVIDER: xai | openai | anthropic | google
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
